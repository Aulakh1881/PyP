# Copy to .env.local and fill in. Never commit real values.

# PayPal sandbox (one demo merchant; master plan §2)
PAYPAL_ENVIRONMENT=SANDBOX
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Which merchant (merchants.id) webhook events belong to; the demo has one
PAYPAL_WEBHOOK_MERCHANT_ID=
SUPABASE_SERVICE_ROLE_KEY=

# Where sign-in on :3000 lands. Blank = http://localhost:3001/app/ (live dashboard, npm run live); :8080 is the demo-data copy
NEXT_PUBLIC_PYP_DASHBOARD_URL=

# Models (gateway/). Provider: anthropic | ollama; unset = anthropic if a key is set, else ollama
PYP_MODEL_PROVIDER=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=
# For example qwen3:4b (8 GB machines); see gateway/README.md
# Thinking for qwen3/gemma4: false (default; JSON goes to the answer), true, or default
OLLAMA_THINK=

# Supabase: sign-in (browser-safe publishable key) and the database
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server only. Supabase: Connect, Session pooler URI (with the database password)
DATABASE_URL=
# Tests only: a Postgres where you may create databases, e.g. postgres://localhost/postgres
TEST_DATABASE_URL=

# Dashboard sign-in (one demo merchant)
DEMO_LOGIN_PASSWORD=
SESSION_SECRET=

# Chrome extension: its id, allowed by CORS (design §11.4)
EXTENSION_ID=

# Daily model budget, fails closed
SPEND_CAP_USD=5

# Only if we keep Inngest
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Pyp-to-Pyp stretch: the buyer's sandbox app
PAYPAL_BUYER_CLIENT_ID=
PAYPAL_BUYER_CLIENT_SECRET=
