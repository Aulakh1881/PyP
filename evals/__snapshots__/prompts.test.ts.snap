exports[`golden prompts > collections overdue turn 1`] = `
"<case-file skill="collections" mode="overdue" generated-at="2026-10-28T15:00:00.000Z">
  <merchant name="Maya Ortiz Design" currency="USD"/>
  <invoice id="INV2-ACME-0042" number="0042" status="UNPAID" total="$1,200.00" amount-due="$1,200.00" due="2026-10-21" days-overdue="7" recipient-name="Sam Lee" recipient-email="sam@acme.example"/>
  <reminders invoice="INV2-ACME-0042" sent="0" last-sent="never" next-reminder="1 of 3"/>
  <client-history source="earlier PayPal invoices, counted by code" invoices="2" paid="2" paid-late="1" avg-days-late="2" other-unpaid="0" pays-after-one-nudge="yes"/>
  <merchant-notes visibility="merchant-only">
    <note>Sam prefers email over phone</note>
  </merchant-notes>
  <rules max-reminders="3" min-days-between="3"/>
</case-file>
<commands>
  <command id="invoice.sendReminder" state="sent=0 of max 3; last=never">
    Send PayPal's reminder email for this unpaid invoice, with your subject line and note.
    Use when: Use when the invoice is overdue and the minimum gap since the last reminder has passed. Reminder 1 friendly, 2 firm and specific, 3 final. The note must state the amount due and the invoice number exactly as the case file shows them.
  </command>
  <command id="invoice.scheduleFollowUp">
    Check this invoice again in a number of days (1 to 14).
    Use when: Use when nothing should go out now but the invoice still needs watching, for example right after a reminder.
  </command>
  <command id="invoice.suggestAutoReminders">
    Suggest the merchant turn on PayPal's automatic reminders for this client. A card only; nothing is sent.
    Use when: Consider it when &lt;client-history pays-after-one-nudge=&quot;yes&quot;&gt;: this client reliably pays after one reminder, so PayPal's own reminders would do the job.
  </command>
  <command id="merchant.ask">
    Ask the merchant a short question, with up to 4 answer buttons.
    Use when: Use when a decision needs a fact or a preference only the merchant has, or when the playbook says to check with them. Keep it to one question.
  </command>
</commands>
<task>Decide what to do about invoice INV2-ACME-0042 now.</task>"
`;

