exports[`golden prompts > collections new-invoice turn 1`] = `
"<case-file skill="collections" mode="new-invoice" generated-at="2026-10-28T15:00:00.000Z">
  <merchant name="Maya Ortiz Design" currency="USD"/>
  <merchant-request>Invoice Acme $1,200 for the October retainer, net 30</merchant-request>
  <known-clients source="recent PayPal invoices">
    <client id="cl_1" name="Sam Lee" business="Acme Studio" email="sam@acme.example" named-in-request="yes"/>
    <client id="cl_2" name="Priya Shah" business="Beta LLC" email="priya@beta.example"/>
    <client id="cl_3" name="Jordan Kim" email="jordan.kim@example.com"/>
  </known-clients>
  <amounts source="parsed from the request by code">
    <amount id="amt_1" value="$1,200.00" written-as="$1,200"/>
  </amounts>
  <terms source="named in the request">
    <term id="net_30" paypal="NET_30" due-date="2026-11-27"/>
  </terms>
  <issue-date value="2026-10-28"/>
</case-file>
<commands>
  <command id="invoice.createAndSend">
    Create a PayPal invoice for a known client and send it.
    Use when: Use when the merchant asked for an invoice for a client marked named-in-request and an amount from &lt;amounts&gt;. Use the terms the merchant named, or the default. Keep the merchant's own words for line descriptions where possible.
  </command>
  <command id="merchant.ask">
    Ask the merchant a short question, with up to 4 answer buttons.
    Use when: Use when a decision needs a fact or a preference only the merchant has, or when the playbook says to check with them. Keep it to one question.
  </command>
</commands>
<task>Turn the merchant's request into one invoice, or ask them what's missing.</task>"
`;

